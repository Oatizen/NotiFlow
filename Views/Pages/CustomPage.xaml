<Page x:Class="NotiFlow.Views.Pages.CustomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:NotiFlow.Models"
      xmlns:converters="clr-namespace:NotiFlow.Converters"
      xmlns:rendering="clr-namespace:NotiFlow.Rendering"
      xmlns:controls="clr-namespace:NotiFlow.Views.Controls"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Title="弹幕设置"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent"
      SizeChanged="Page_SizeChanged"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Page.DataContext>
        <viewmodels:SettingsViewModel />
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="EditableValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <converters:BooleanToAppearanceConverter x:Key="BoolToAppearance" />
        <converters:BooleanToAppearanceConverter x:Key="InverseBoolToAppearance" Invert="True"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SmoothExpanderStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleY="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ExpandStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard x:Name="CollapseStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Flyouts for interactive static preview -->
        <Popup x:Key="AppIconFlyout" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Width="300" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" TextElement.FontSize="14" TextElement.FontStyle="Normal" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <StackPanel Width="268">
                    <StackPanel Orientation="Horizontal" Height="32" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Image24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="图标设置" FontTypography="BodyStrong" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid Margin="0,0,0,4">
                        <ui:TextBlock Text="缩放比例" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <TextBox Text="{Binding AppIconScale, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Style="{StaticResource EditableValueTextBoxStyle}"/>
                            <ui:TextBlock Text="x" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0.5" Maximum="2.0" Value="{Binding AppIconScale, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>
                    
                    <!-- Windows 模式开关 -->
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsWindowsNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:TextBlock Text="显示应用图标" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding ShowAppIcon, Mode=TwoWay}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 邮箱模式开关 -->
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsEmailNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:TextBlock Text="显示邮箱图标" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding ShowEmailIcon, Mode=TwoWay}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Key="AppNameFlyout" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Width="608" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" TextElement.FontSize="14" TextElement.FontStyle="Normal" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Grid Width="576">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 顶部标题栏固定高度 32px，确保按钮显隐时面板高度绝对恒定 -->
                    <Grid Grid.Row="0" Height="32" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding AppNameFlyoutTitle}" FontTypography="BodyStrong" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Content="恢复为全局设置"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   Appearance="Transparent"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Command="{Binding ResetAppNameSettingsCommand}"
                                   Visibility="{Binding HasAppNameCustomSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Height="30"
                                   Padding="8,0"
                                   FontSize="12"
                                   Cursor="Hand"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 左边：文字 -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="TextFont24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                    <ui:TextBlock Text="文字" FontTypography="BodyStrong"/>
                                </StackPanel>
                                
                                <ui:TextBlock Text="字体"/>
                                <ComboBox SelectedValue="{Binding AppNameFontFamilyName, Mode=TwoWay}" SelectedValuePath="Family.Source" ItemsSource="{Binding AvailableFonts}" Margin="0,4,0,16" HorizontalAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LocalizedName}" VerticalAlignment="Center" ToolTip="{Binding LocalizedName}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="Abc弹幕" FontFamily="{Binding Family}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="字体大小" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding AppNameFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="64" Value="{Binding AppNameFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="文字间距" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding AppNameLetterSpacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="20" Value="{Binding AppNameLetterSpacing, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <ui:TextBlock Text="字重"/>
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="常规" Command="{Binding SetAppNameFontWeightCommand}" CommandParameter="Normal" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Secondary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AppNameFontWeight}" Value="Normal"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding AppNameFontWeight}" Value=""><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Content="加粗" Command="{Binding SetAppNameFontWeightCommand}" CommandParameter="Bold" Grid.Column="1" HorizontalAlignment="Stretch" Margin="4,0,0,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Secondary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AppNameFontWeight}" Value="Bold"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                                
                                <ui:TextBlock Text="字体样式"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Content="斜体" IsChecked="{Binding AppNameIsFontStyleItalic, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <ToggleButton Grid.Column="1" Content="下划线" IsChecked="{Binding AppNameIsUnderlined, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- 右边：外观 -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="Color24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                    <ui:TextBlock Text="外观" FontTypography="BodyStrong"/>
                                </StackPanel>
                                
                                <ui:TextBlock Text="文字颜色"/>
                                <ui:TextBlock Text="点击方框或输入16进制色号改变颜色" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="AppNameColorPickerContainer" Margin="0,0,8,0" HorizontalAlignment="Left" Cursor="Hand">
                                        <ToggleButton x:Name="AppNameColorToggle" IsChecked="{Binding IsAppNameColorPickerOpen, Mode=TwoWay}" Cursor="Hand" ForceCursor="True" Background="{Binding AppNameTextColorBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Width="36" Height="36" Padding="0" ToolTip="点击选择颜色"/>
                                        <Popup PlacementTarget="{Binding ElementName=AppNameColorToggle}" Placement="Bottom" IsOpen="{Binding IsAppNameColorPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                <controls:ModernColorPicker SelectedColor="{Binding AppNameTextColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="0"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ui:TextBox Text="{Binding AppNameTextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="跟随全局" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="文字不透明度" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding AppNameTextOpacityPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="%" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding AppNameTextOpacityPercentage, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="显示文字描边"/>
                                        <ui:TextBlock Text="在复杂背景下提高文字可读性" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="{Binding AppNameShowTextStroke, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- 1. Windows 模式：显示应用名称 -->
                                <Grid Visibility="{Binding IsWindowsNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:TextBlock Text="显示应用名称"/>
                                        <ui:TextBlock Text="弹幕前显示应用名称" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAppName, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 2. 邮箱模式：收件邮箱名称 -->
                                <Grid Visibility="{Binding IsReceiverNameActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:TextBlock Text="显示收件邮箱名称"/>
                                        <ui:TextBlock Text="弹幕前显示收件邮箱自定义备注名" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowReceiverName, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 3. 邮箱模式：收件邮箱地址 -->
                                <Grid Visibility="{Binding IsReceiverAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:TextBlock Text="显示收件邮箱地址"/>
                                        <ui:TextBlock Text="弹幕前显示完整收件邮箱地址" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowReceiverAddress, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 4. 邮箱模式：发件邮箱名称 -->
                                <Grid Visibility="{Binding IsSenderNameActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:TextBlock Text="显示发件邮箱名称"/>
                                        <ui:TextBlock Text="弹幕前显示发件人姓名或品牌名" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSenderName, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 5. 邮箱模式：发件邮箱地址 -->
                                <Grid Visibility="{Binding IsSenderAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:TextBlock Text="显示发件邮箱地址"/>
                                        <ui:TextBlock Text="弹幕前显示发件人原生邮箱地址" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSenderAddress, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Key="ContentFlyout" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Width="608" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" TextElement.FontSize="14" TextElement.FontStyle="Normal" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Grid Width="576">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 顶部标题栏固定高度 32px，确保按钮显隐时面板高度绝对恒定 -->
                    <Grid Grid.Row="0" Height="32" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="TextFont24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding ContentFlyoutTitle}" FontTypography="BodyStrong" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Content="恢复为全局设置"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   Appearance="Transparent"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Command="{Binding ResetContentSettingsCommand}"
                                   Visibility="{Binding HasContentCustomSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Height="30"
                                   Padding="8,0"
                                   FontSize="12"
                                   Cursor="Hand"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 左边：文字 -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="TextFont24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                    <ui:TextBlock Text="文字" FontTypography="BodyStrong"/>
                                </StackPanel>
                                
                                <ui:TextBlock Text="字体"/>
                                <ComboBox SelectedValue="{Binding ContentFontFamilyName, Mode=TwoWay}" SelectedValuePath="Family.Source" ItemsSource="{Binding AvailableFonts}" Margin="0,4,0,16" HorizontalAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LocalizedName}" VerticalAlignment="Center" ToolTip="{Binding LocalizedName}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="Abc弹幕" FontFamily="{Binding Family}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="字体大小" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding ContentFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="64" Value="{Binding ContentFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="文字间距" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding ContentLetterSpacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="20" Value="{Binding ContentLetterSpacing, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <ui:TextBlock Text="字重"/>
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="常规" Command="{Binding SetContentFontWeightCommand}" CommandParameter="Normal" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Secondary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContentFontWeight}" Value="Normal"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding ContentFontWeight}" Value=""><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Content="加粗" Command="{Binding SetContentFontWeightCommand}" CommandParameter="Bold" Grid.Column="1" HorizontalAlignment="Stretch" Margin="4,0,0,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Secondary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContentFontWeight}" Value="Bold"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                                
                                <ui:TextBlock Text="字体样式"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Content="斜体" IsChecked="{Binding ContentIsFontStyleItalic, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <ToggleButton Grid.Column="1" Content="下划线" IsChecked="{Binding ContentIsUnderlined, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- 右边：外观 -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="Color24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                    <ui:TextBlock Text="外观" FontTypography="BodyStrong"/>
                                </StackPanel>
                                
                                <ui:TextBlock Text="文字颜色"/>
                                <ui:TextBlock Text="点击方框或输入16进制色号改变颜色" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="ContentColorPickerContainer" Margin="0,0,8,0" HorizontalAlignment="Left" Cursor="Hand">
                                        <ToggleButton x:Name="ContentColorToggle" IsChecked="{Binding IsContentColorPickerOpen, Mode=TwoWay}" Cursor="Hand" ForceCursor="True" Background="{Binding ContentTextColorBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Width="36" Height="36" Padding="0" ToolTip="点击选择颜色"/>
                                        <Popup PlacementTarget="{Binding ElementName=ContentColorToggle}" Placement="Bottom" IsOpen="{Binding IsContentColorPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                <controls:ModernColorPicker SelectedColor="{Binding ContentTextColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="0"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ui:TextBox Text="{Binding ContentTextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="跟随全局" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="文字不透明度" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                        <TextBox Text="{Binding ContentTextOpacityPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                        <ui:TextBlock Text="%" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding ContentTextOpacityPercentage, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="显示文字描边"/>
                                        <ui:TextBlock Text="在复杂背景下提高文字可读性" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="{Binding ContentShowTextStroke, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Key="EllipsisFlyout" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Width="300" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" TextElement.FontSize="14" TextElement.FontStyle="Normal" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <StackPanel Width="268">
                    <StackPanel Orientation="Horizontal" Height="32" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="省略号设置" FontTypography="BodyStrong" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ui:TextBlock Text="文字颜色" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="EllipsisColorPickerContainer" Margin="0,0,8,0" HorizontalAlignment="Left" Cursor="Hand">
                            <ToggleButton x:Name="EllipsisColorToggle" IsChecked="{Binding IsEllipsisColorPickerOpen, Mode=TwoWay}" Cursor="Hand" ForceCursor="True" Background="{Binding EllipsisColorBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Width="36" Height="36" Padding="0" ToolTip="点击选择颜色"/>
                            <Popup PlacementTarget="{Binding ElementName=EllipsisColorToggle}" Placement="Bottom" IsOpen="{Binding IsEllipsisColorPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <controls:ModernColorPicker SelectedColor="{Binding EllipsisColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="0"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ui:TextBox Text="{Binding EllipsisColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="跟随全局" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,4">
                        <ui:TextBlock Text="字体大小" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <TextBox Text="{Binding EllipsisFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                            <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0" Maximum="64" Value="{Binding EllipsisFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <ui:TextBlock Text="不透明度" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <TextBox Text="{Binding EllipsisTextOpacityPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                            <ui:TextBlock Text="%" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0" Maximum="100" Value="{Binding EllipsisTextOpacityPercentage, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Key="CharacterWidgetFlyout" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Width="300" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" TextElement.FontSize="14" TextElement.FontStyle="Normal" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <StackPanel Width="268">
                    <Grid Height="32" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="Sticker24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="弹幕挂件设置" FontTypography="BodyStrong" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="显示弹幕挂件"/>
                            <ui:TextBlock Text="在弹幕外附带挂件装饰" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding ShowCharacterWidget, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Style="{StaticResource SmoothExpanderStyle}" Tag="{Binding ShowCharacterWidget}">
                        <ui:TextBlock Text="选择伴随角色" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding CharacterPresets}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0" Margin="0,0,12,8" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.SelectCharacterPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand">
                                        <Border Width="80" Height="80" CornerRadius="8" Padding="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Image Grid.Row="0" Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="44" MaxHeight="44"
                                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsCustom}" Value="True"/>
                                                                        <Condition Binding="{Binding ImagePath}" Value=""/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                    </Image>

                                                    <ui:SymbolIcon Grid.Row="0" Symbol="Add24" FontSize="26" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCustom}" Value="True"/>
                                                                            <Condition Binding="{Binding ImagePath}" Value=""/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>

                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="Transparent" ScrollChanged="MainScrollViewer_ScrollChanged">
        <StackPanel Margin="24,12,24,24" Background="Transparent">

            <!-- 页面大标题 -->
            <Grid Margin="0,0,0,24">
                <ui:TextBlock FontTypography="TitleLarge" Text="弹幕设置" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="ToggleWorkButton" Appearance="Primary" Content="开启" Click="ToggleWorkButton_Click" Padding="24,0" Height="36" MinWidth="100" Margin="0,0,12,0"/>
                    <Grid>
                        <ui:Button x:Name="HelpButton" Icon="{ui:SymbolIcon QuestionCircle24}" Appearance="Transparent" Height="36" Width="36" Padding="0" Click="HelpButton_Click"/>
                        <ui:Flyout x:Name="HelpFlyout" Placement="Bottom">
                            <ui:TextBlock Text="仅支持在窗口模式或无边框窗口模式的应用上显示通知，不支持以全屏模式运行的应用" TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ui:Flyout>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 目标作用域选择器（严格固定 38px 高度并开启像素对齐，彻底杜绝切换分类时的 1 像素抖动） -->
            <StackPanel Orientation="Horizontal" 
                        Height="38"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        Margin="0,0,0,24" 
                        VerticalAlignment="Center">
                <ui:TextBlock Text="当前设置范围：" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- 1. 通知大类分段选择器：Windows 通知 VS 邮箱 -->
                <Border Height="36"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="3" 
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Windows通知" 
                                   Command="{Binding SetNotificationCategoryCommand}" 
                                   CommandParameter="Windows" 
                                   Height="28"
                                   VerticalAlignment="Center"
                                   Padding="14,0">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCategory}" Value="Windows">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="邮箱" 
                                   Command="{Binding SetNotificationCategoryCommand}" 
                                   CommandParameter="Email" 
                                   Height="28"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" 
                                   Padding="14,0">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCategory}" Value="Email">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- 2. Windows 通知模式下的子范围分段控件 -->
                <StackPanel Orientation="Horizontal" 
                            Height="38"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsWindowsNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Height="36"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="全局" 
                                       Command="{Binding SetScopeCategoryCommand}" 
                                       CommandParameter="Global" 
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Padding="14,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScopeCategory}" Value="Global">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="生效场景" 
                                       Command="{Binding SetScopeCategoryCommand}" 
                                       CommandParameter="Scene" 
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" 
                                       Padding="14,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScopeCategory}" Value="Scene">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="通知来源" 
                                       Command="{Binding SetScopeCategoryCommand}" 
                                       CommandParameter="Source" 
                                       Height="28"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" 
                                       Padding="14,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScopeCategory}" Value="Source">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Windows 目标选择下拉框 -->
                    <ComboBox ItemsSource="{Binding FilteredScopes}" 
                              SelectedItem="{Binding SelectedScope, Mode=TwoWay}" 
                              Height="36"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0" 
                              Width="200"
                              Visibility="{Binding ComboBoxVisibility}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverride}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 清除自定义设置按钮 -->
                    <ui:Button Appearance="Transparent" 
                               Height="36"
                               Width="36"
                               Padding="0"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" 
                               ToolTip="恢复全局设置" 
                               Command="{Binding ClearScopeOverrideCommand}"
                               Visibility="{Binding ClearButtonVisibility}">
                        <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </ui:Button>
                </StackPanel>

                <!-- 3. 邮箱模式下的选择框（下拉列表，顶部全局，其下列出用户绑定的所有邮箱：左侧备注名，右侧邮箱地址） -->
                <StackPanel Orientation="Horizontal" 
                            Height="38"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmailNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding EmailScopes}" 
                              SelectedItem="{Binding SelectedEmailScope, Mode=TwoWay}" 
                              Height="36"
                              VerticalAlignment="Center"
                              Width="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,6,2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 覆盖标识圆点 -->
                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverride}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- 左侧：自定义备注名称 -->
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- 右侧：邮箱账号地址 -->
                                    <TextBlock Grid.Column="2" Text="{Binding EmailAddress}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 邮箱清除自定义设置按钮 -->
                    <ui:Button Appearance="Transparent" 
                               Height="36"
                               Width="36"
                               Padding="0"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" 
                               ToolTip="恢复全局设置" 
                               Command="{Binding ClearEmailScopeOverrideCommand}"
                               Visibility="{Binding HasEmailScopeOverride, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </ui:Button>
                </StackPanel>

            </StackPanel>

            <!-- 第一区域：弹幕预览区 -->
            <StackPanel Margin="0,0,0,24">
                <Grid Margin="0,0,0,16">
                    <ui:TextBlock Text="弹幕预览" FontTypography="BodyStrong" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="PausePreviewButton" Content="暂停以编辑" HorizontalAlignment="Right" Click="PausePreviewButton_Click"/>
                </Grid>

                <Border x:Name="PreviewBorder" Height="200" Background="#1c1c1c" CornerRadius="12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True">
                    <Canvas x:Name="PreviewCanvas" />
                </Border>
            </StackPanel>

            <!-- 第二区域：双列设置项 -->
            <Grid x:Name="SettingsGrid" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftSettingsStack" Grid.Column="0">
                    <!-- 左列：内容设置 -->
                <Border x:Name="LeftSettingsCard" Margin="0,0,0,24" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <!-- 区域标题 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="TextFont24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock FontTypography="BodyStrong" Text="内容" FontSize="16"/>
                        </StackPanel>

                        <ui:TextBlock Text="字体" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFontItem, Mode=TwoWay}" MaxDropDownHeight="300" ScrollViewer.VerticalScrollBarVisibility="Visible" Margin="0,0,0,18" HorizontalAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LocalizedName}" VerticalAlignment="Center" ToolTip="{Binding LocalizedName}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="Abc弹幕" FontFamily="{Binding Family}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="字体大小"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="12" Maximum="64" Value="{Binding FontSize, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,18" />
                        
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="文字间距"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding LetterSpacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="0" Maximum="20" Value="{Binding LetterSpacing, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,18" />

                        <ui:TextBlock Text="字重" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ui:Button Grid.Row="0" Content="常规" Command="{Binding SetFontWeightCommand}" CommandParameter="False" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFontWeightBold}" Value="False">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Grid.Row="1" Content="加粗" Command="{Binding SetFontWeightCommand}" CommandParameter="True" HorizontalAlignment="Stretch">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFontWeightBold}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>

                        <ui:TextBlock Text="字体样式" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="斜体" Command="{Binding ToggleFontStyleCommand}" HorizontalAlignment="Stretch">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFontStyleItalic}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Grid.Column="2" Content="下划线" Command="{Binding ToggleUnderlineCommand}" HorizontalAlignment="Stretch">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnderline}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>

                        <Grid Margin="0,18,0,8">
                            <ui:TextBlock Text="弹幕最大长度"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding MaxTextLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="字" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" Value="{Binding MaxTextLength, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,18" />
                    </StackPanel>
                </Border>
                    
                    <!-- 左列：动画设置 -->
                <Border x:Name="AnimationCard" Margin="0,0,0,24" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock FontTypography="BodyStrong" Text="动画" FontSize="16"/>
                        </StackPanel>
                    
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="动画速度"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding ScrollSpeedCharsPerSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="字/秒" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="5" Maximum="30" Value="{Binding ScrollSpeedCharsPerSec, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    </StackPanel>
                </Border>
                    
                    <!-- 左列：其他设置 -->
                    <Border x:Name="OtherCard" Margin="0,0,0,16" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Options24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <ui:TextBlock FontTypography="BodyStrong" Text="其他" FontSize="16"/>
                            </StackPanel>

                            <ui:TextBlock Text="弹幕位置" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="居中偏上" Command="{Binding SetTrackStrategyCommand}" CommandParameter="UpperCenter" HorizontalAlignment="Stretch" Padding="4,6">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackUpperCenter}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Grid.Column="2" Content="顶部优先" Command="{Binding SetTrackStrategyCommand}" CommandParameter="TopFirst" HorizontalAlignment="Stretch" Padding="4,6">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackTopFirst}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Grid.Column="4" Content="底部优先" Command="{Binding SetTrackStrategyCommand}" CommandParameter="BottomFirst" HorizontalAlignment="Stretch" Padding="4,6">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackBottomFirst}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 左列：多显示器独立卡片 -->
                    <Border x:Name="MultiMonitorCard" Margin="0,0,0,0" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <ui:TextBlock FontTypography="BodyStrong" Text="多显示器" FontSize="16"/>
                            </StackPanel>

                            <ui:TextBlock Text="显示器列表" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="拖拽卡片可调整排列顺序，右侧按钮可开关弹幕" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                            <!-- 显示器卡片列表 -->
                            <ItemsControl ItemsSource="{Binding MonitorList}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="{Binding}"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="MonitorCard_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="MonitorCard_PreviewMouseMove"
                                                Drop="MonitorCard_Drop"
                                                DragOver="MonitorCard_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖拽把手图标与编号 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Cursor="SizeAll" Margin="0,0,6,0"/>
                                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayOrder}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 显示器名称与分辨率 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <!-- 主显示器高亮徽标 -->
                                                        <Border Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="主屏" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ResolutionText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- 右侧状态矩形切换按钮 -->
                                                <ui:Button Grid.Column="2"
                                                           Command="{Binding DataContext.ToggleMonitorEnabledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="14,4"
                                                           Height="28"
                                                           MinWidth="72"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Appearance" Value="Secondary"/>
                                                            <Setter Property="Content" Value="未启用"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Appearance" Value="Primary"/>
                                                                    <Setter Property="Content" Value="已启用"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 显示模式选项 -->
                            <ui:TextBlock Text="显示模式" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="同时显示" Command="{Binding SetMultiMonitorModeCommand}" CommandParameter="Simultaneous" HorizontalAlignment="Stretch" Padding="4,6">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModeSimultaneous}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Grid.Column="2" Content="按顺序流转" Command="{Binding SetMultiMonitorModeCommand}" CommandParameter="Sequential" HorizontalAlignment="Stretch" Padding="4,6">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModeSequential}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 右列：外观设置 -->
                <Border x:Name="RightSettingsCard" Grid.Column="2" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <!-- 区域标题 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Color24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock FontTypography="BodyStrong" Text="外观" FontSize="16"/>
                        </StackPanel>

                        <!-- 文本颜色 -->
                        <ui:TextBlock Text="文字颜色" Margin="0,0,0,0"/>
                        <ui:TextBlock Text="点击方框或输入16进制色号改变颜色" Margin="0,4,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Button Padding="0" BorderThickness="0" Background="Transparent" Click="ColorPickerButton_Click" Cursor="Hand">
                                    <Border Width="40" Height="40" Background="{Binding TextColorBrush}" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                                </Button>
                                
                                <ui:Flyout x:Name="ColorPaletteFlyout" Placement="Bottom">
                                    <controls:ModernColorPicker SelectedColor="{Binding TextColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="4"/>
                                </ui:Flyout>
                            </Grid>
                            
                            <ui:TextBox Grid.Column="1" Text="{Binding TextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HEX (例如: #FFFFFF)" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="文字不透明度"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding TextOpacityPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="%" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding TextOpacityPercentage, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,22" />

                        <!-- 文字描边 -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock Text="显示文字描边"/>
                                <ui:TextBlock Text="在复杂背景下提高文字可读性" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding ShowTextStroke, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Style="{StaticResource SmoothExpanderStyle}" Tag="{Binding ShowTextStroke}">
                            <ui:TextBlock Text="描边颜色" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Button Padding="0" BorderThickness="0" Background="Transparent" Click="TextStrokeColorPickerButton_Click" Cursor="Hand">
                                        <Border Width="40" Height="40" Background="{Binding TextStrokeColorBrush}" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                                    </Button>
                                    
                                    <ui:Flyout x:Name="TextStrokeColorPaletteFlyout" Placement="Bottom">
                                        <controls:ModernColorPicker SelectedColor="{Binding TextStrokeColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="4"/>
                                    </ui:Flyout>
                                </Grid>
                                <ui:TextBox Grid.Column="1" Text="{Binding TextStrokeColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HEX (例: #000000)" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <ui:TextBlock Text="描边粗细"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding TextStrokeThickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="px" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                            </Grid>
                            <Slider Minimum="0.1" Maximum="5" Value="{Binding TextStrokeThickness, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,22" />
                        </StackPanel>

                        <!-- 背景颜色 -->
                        <ui:TextBlock Text="背景遮罩颜色" Margin="0,0,0,0"/>
                        <ui:TextBlock Text="自定义弹幕背景色的颜色值" Margin="0,4,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Button Padding="0" BorderThickness="0" Background="Transparent" Click="BackgroundColorPickerButton_Click" Cursor="Hand">
                                    <Border Width="40" Height="40" Background="{Binding BackgroundColorBrush}" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                                </Button>
                                
                                <ui:Flyout x:Name="BackgroundColorPaletteFlyout" Placement="Bottom">
                                    <controls:ModernColorPicker SelectedColor="{Binding BackgroundColorHex, Mode=TwoWay}" PresetColors="{Binding PresetColors}" Margin="4"/>
                                </ui:Flyout>
                            </Grid>
                            
                            <ui:TextBox Grid.Column="1" Text="{Binding BackgroundColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HEX (例如: #000000)" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="背景不透明度"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Text="{Binding BackgroundOpacityPercentage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" Style="{StaticResource EditableValueTextBoxStyle}" />
                                <ui:TextBlock Text="%" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacityPercentage, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,22" />
                        
                        <!-- 背景图设置 -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <ui:TextBlock Text="自定义背景图"/>
                                <ui:TextBlock Text="使用图片作为弹幕背景装饰" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding ShowBackgroundImage, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <StackPanel Style="{StaticResource SmoothExpanderStyle}" Tag="{Binding ShowBackgroundImage}">
                            <Button Content="打开画板设置背景图..." HorizontalAlignment="Stretch" Margin="0,0,0,22" 
                                    Click="OpenBackgroundImageEditor_Click" />
                        </StackPanel>

                        <!-- 弹幕挂件设置 -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <ui:TextBlock Text="显示弹幕挂件"/>
                                <ui:TextBlock Text="在弹幕外附带挂件装饰" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding ShowCharacterWidget, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Style="{StaticResource SmoothExpanderStyle}" Tag="{Binding ShowCharacterWidget}">
                            <!-- 预设选择器横向卡片列表 (左边自定义上传，右边预设) -->
                            <ItemsControl ItemsSource="{Binding CharacterPresets}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" Margin="0,0,12,8" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.SelectCharacterPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"
                                                Cursor="Hand">
                                            <Border Width="80" Height="80" CornerRadius="8" Padding="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 预设或自定义图片 (启用高质量抗锯齿渲染) -->
                                                    <Image Grid.Row="0" Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="44" MaxHeight="44"
                                                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCustom}" Value="True"/>
                                                                            <Condition Binding="{Binding ImagePath}" Value=""/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- 自定义上传加号图标 -->
                                                    <ui:SymbolIcon Grid.Row="0" Symbol="Add24" FontSize="26" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCustom}" Value="True"/>
                                                                            <Condition Binding="{Binding ImagePath}" Value=""/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>

                                                    <!-- 下方名称 -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- A. Windows 通知模式开关 -->
                        <StackPanel Visibility="{Binding IsWindowsNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示应用图标"/>
                                    <ui:TextBlock Text="弹幕前显示应用图标" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowAppIcon, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示应用名称"/>
                                    <ui:TextBlock Text="弹幕前显示应用名称" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowAppName, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <!-- B. 邮箱模式开关 -->
                        <StackPanel Visibility="{Binding IsEmailNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示邮件图标"/>
                                    <ui:TextBlock Text="弹幕前显示邮箱品牌或协议图标" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowEmailIcon, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示收件邮箱名称"/>
                                    <ui:TextBlock Text="弹幕前显示收件邮箱自定义备注名" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowReceiverName, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示收件邮箱地址"/>
                                    <ui:TextBlock Text="弹幕前显示完整收件邮箱地址" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowReceiverAddress, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示发件邮箱名称"/>
                                    <ui:TextBlock Text="弹幕前显示发件人姓名或品牌名" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowSenderName, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <ui:TextBlock Text="显示发件邮箱地址"/>
                                    <ui:TextBlock Text="弹幕前显示发件人原生邮箱地址" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowSenderAddress, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,0">
                            <StackPanel>
                                <ui:TextBlock Text="省略号高对比度显示"/>
                                <ui:TextBlock Text="高亮被截断的弹幕标识" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HighlightEllipsis, Mode=TwoWay}"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </Grid>

            
        </StackPanel>
    </ScrollViewer>
</Page>
